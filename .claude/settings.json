{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make test)",
      "Bash(make lint)",
      "Bash(make test-*)",
      "Bash(make lint-*)",
      "Bash(uv sync)",
      "Bash(uv sync *)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uvx pytest@* agent-hooks/tests *)",
      "Bash(uvx ruff@* check *)",
      "Bash(uvx ruff@* format --check *)",
      "Bash(npm ci)",
      "Bash(npm run lint)",
      "Bash(npm run lint *)",
      "Bash(npm run test)",
      "Bash(npm run test *)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm run build)",
      "Bash(terraform fmt *)",
      "Bash(terraform -chdir=* init -backend=false)",
      "Bash(terraform -chdir=* validate)",
      "Bash(terraform -chdir=* validate *)",
      "Bash(tflint)",
      "Bash(tflint *)",
      "Bash(helm lint *)",
      "Bash(helm template *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch --show-current)",
      "Bash(git symbolic-ref --short -q HEAD)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)",
      "Bash(git blame *)",
      "Bash(git remote -v)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Edit(./.github/workflows/**)",
      "Write(./.github/workflows/**)",
      "Edit(./**/CLAUDE.md)",
      "Write(./**/CLAUDE.md)",
      "Edit(./**/CLAUDE.local.md)",
      "Write(./**/CLAUDE.local.md)",
      "Bash(terraform apply*)",
      "Bash(terraform * apply*)",
      "Bash(terraform destroy*)",
      "Bash(terraform * destroy*)",
      "Bash(terraform import*)",
      "Bash(terraform * import*)",
      "Bash(terraform taint*)",
      "Bash(terraform * taint*)",
      "Bash(terraform untaint*)",
      "Bash(terraform * untaint*)",
      "Bash(terraform force-unlock*)",
      "Bash(terraform * force-unlock*)",
      "Bash(terraform refresh*)",
      "Bash(terraform * refresh*)",
      "Bash(terraform state rm*)",
      "Bash(terraform * state rm*)",
      "Bash(terraform state mv*)",
      "Bash(terraform * state mv*)",
      "Bash(terraform state push*)",
      "Bash(terraform * state push*)",
      "Bash(terraform state replace-provider*)",
      "Bash(terraform * state replace-provider*)",
      "Bash(terraform workspace new*)",
      "Bash(terraform * workspace new*)",
      "Bash(terraform workspace delete*)",
      "Bash(terraform * workspace delete*)",
      "Bash(terraform workspace select*)",
      "Bash(terraform * workspace select*)",
      "Bash(kubectl apply *)",
      "Bash(kubectl * apply *)",
      "Bash(kubectl create *)",
      "Bash(kubectl * create *)",
      "Bash(kubectl delete *)",
      "Bash(kubectl * delete *)",
      "Bash(kubectl edit *)",
      "Bash(kubectl * edit *)",
      "Bash(kubectl patch *)",
      "Bash(kubectl * patch *)",
      "Bash(kubectl replace *)",
      "Bash(kubectl * replace *)",
      "Bash(kubectl scale *)",
      "Bash(kubectl * scale *)",
      "Bash(kubectl rollout restart *)",
      "Bash(kubectl rollout undo *)",
      "Bash(kubectl label *)",
      "Bash(kubectl * label *)",
      "Bash(kubectl annotate *)",
      "Bash(kubectl * annotate *)",
      "Bash(kubectl drain *)",
      "Bash(kubectl * drain *)",
      "Bash(kubectl cordon *)",
      "Bash(kubectl * cordon *)",
      "Bash(kubectl exec *)",
      "Bash(kubectl * exec *)",
      "Bash(kubectl cp *)",
      "Bash(kubectl * cp *)",
      "Bash(kubectl run *)",
      "Bash(kubectl * run *)",
      "Bash(helm install *)",
      "Bash(helm * install *)",
      "Bash(helm upgrade *)",
      "Bash(helm * upgrade *)",
      "Bash(helm uninstall *)",
      "Bash(helm * uninstall *)",
      "Bash(helm rollback *)",
      "Bash(helm * rollback *)",
      "Bash(aws configure*)",
      "Bash(aws sso login*)",
      "Bash(eksctl*)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(gh pr merge*)",
      "Bash(gh secret*)",
      "Bash(gh variable*)",
      "Bash(gh api*)",
      "Bash(gh repo edit*)",
      "Bash(gh workflow run*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|MultiEdit|NotebookEdit|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/agent-hooks/guard.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/agent-hooks/lint_edited.py\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
