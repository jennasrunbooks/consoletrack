# ConsoleTrack configuration. This is the only config file.
#
#   cp .env.example .env     # then fill in the values below
#
# Rules:
# - One KEY=value per line, no quotes, no spaces around "=". Make, Docker Compose, and
#   `op run --env-file` all read this file, and they only agree on that plain form.
# - Anything already set in your shell wins over .env, so secrets can stay empty here and come
#   from a keychain or password manager instead, e.g. `op run --env-file=.env -- make up`.
# - GitHub Actions uses the same names for its secrets and variables.
# - `make env-check-up`, `env-check-aws`, and `env-check-local` list the required variables a
#   kind of target is missing (names only, never values). `make lint` and `make test` need none.
#
# Derived by the Makefile or generated by scripts. Don't set these here:
# - TF_VAR_* for every Terraform input below (`make tf-env` lists the mapping)
# - Terraform backend config: state bucket ct-tfstate-<NAME_SUFFIX> in AWS_REGION
# - The `owner` resource tag, which is NAME_SUFFIX (there is no OWNER variable; see #3)
# - helm/**/values.generated.yaml, the Helm values built from this file
# - Admin and viewer passwords, the session secret, and the Alertmanager webhook bearer token,
#   which a script generates and writes to Kubernetes Secrets (never to Terraform state)

# --- AWS ------------------------------------------------------------------------------------

# AWS CLI profile for your sandbox account (admin needed for the first `make up`).
AWS_PROFILE=
# Region for the platform and the change intake. Keep us-east-1: IAM's CloudTrail events reach
# EventBridge only there (product-spec.md → AWS design and cost).
AWS_REGION=us-east-1
# Short random suffix on every resource name (ct-<component>-<suffix>), so two people can share
# an account. Leave empty: `make bootstrap` generates one and tells you to paste it here.
NAME_SUFFIX=
# Optional. IAM role or user ARN allowed to assume the demo "developer" role (make demo-drift,
# make demo-identity). Empty = whoever runs Terraform on terraform/consoletrack/global; an SSO
# or other assumed-role login is resolved to its role. Set it before CI applies that root, or
# the trust would switch to the CI apply role. It contains your account ID: keep it in .env or
# a GitHub variable, never in the repo.
OPERATOR_ARN=

# --- GitHub ---------------------------------------------------------------------------------

# owner/repo that the GitHub OIDC roles trust, i.e. your fork.
GITHUB_REPO=
# Create the GitHub OIDC provider and the CI plan/apply/deploy/revert roles. Reviewers can leave
# this off; Revert then runs locally with `make revert CHANGE=<id>`.
ENABLE_GITHUB_OIDC=false
# Optional. Secret for GitHub's workflow_run webhook, which tells the backend a revert run has
# finished. The backend polls the run's status anyway, so leave this empty unless you use
# EXPOSURE=alb (GitHub can't reach a port-forward). To use it, generate one with
# `openssl rand -hex 32`, enter the same value in the repo's webhook settings, and preferably
# export it from your shell or `op run` rather than keeping it in this file.
GITHUB_WEBHOOK_SECRET=
# GitHub's numeric owner and repository IDs for GITHUB_REPO. GitHub's OIDC tokens can name the
# repo by ID (repo:<owner>@<owner_id>/<repo>@<repo_id>:...), which a deleted or renamed repo
# can't reuse. Set both to make the CI roles trust that form; leave both empty for the classic
# repo:<owner>/<repo>:... form. Not secret. Get them with:
#   gh api repos/<owner>/<repo> --jq '.owner.id, .id'
# CI fills them in from github.repository_owner_id and github.repository_id.
GITHUB_OWNER_ID=
GITHUB_REPO_ID=

# --- Cluster --------------------------------------------------------------------------------

# EKS Kubernetes version: the latest in standard support (extended support costs 6x). 1.36 is
# in standard support until Aug 2, 2027. `make preflight` checks it for your region.
K8S_VERSION=1.36
# Spot nodes cost about half. Set false if you hit Spot capacity errors or for demo day.
USE_SPOT=true
# Graviton (arm64) node type; the images are arm64 only.
NODE_INSTANCE_TYPE=t4g.medium
# VPC range (/16 to /20). Change it only if it overlaps a network you peer or VPN with.
VPC_CIDR=10.0.0.0/16
# Comma-separated CIDRs allowed to reach the EKS API's public endpoint (still IAM-authenticated).
# Keep 0.0.0.0/0 while CI deploys from GitHub-hosted runners, whose ranges don't fit EKS's
# 40-CIDR limit; with ENABLE_GITHUB_OIDC=false you can narrow it to your own IP.
EKS_PUBLIC_ACCESS_CIDRS=0.0.0.0/0

# --- Exposure -------------------------------------------------------------------------------

# How to reach the dashboard: port-forward (`make open`, nothing public, no extra cost) or alb
# (an HTTPS ALB limited to ALLOWED_CIDRS, about $0.035/hour more). alb requires DOMAIN: without
# a certificate the ALB would serve plain HTTP, the browser would drop the Secure session cookie
# so login fails, and the admin password would travel unencrypted. `make env-check-up` enforces it.
EXPOSURE=port-forward
# Comma-separated CIDRs allowed to reach the ALB. Empty = your current public IP, filled in by
# `make preflight`. Only used with EXPOSURE=alb.
ALLOWED_CIDRS=
# Hostname for HTTPS, e.g. consoletrack.example.com. Required with EXPOSURE=alb (the ACM
# certificate is issued for it); leave empty with port-forward.
DOMAIN=
# How DOMAIN's zone is delegated: external (any other DNS provider; `make domain-zone` prints
# the NS records to add) or route53 (parent zone is in this account; Terraform adds them).
DNS_PARENT=external

# --- Cost -----------------------------------------------------------------------------------

# Create an AWS Budgets alert. Turn off if billing lives in another account (an Organizations
# management account) where budgets can't be created from here.
ENABLE_BUDGET=true
# Monthly budget threshold in USD.
BUDGET_LIMIT_USD=25
# Where the budget alert email goes. Required when ENABLE_BUDGET=true.
BUDGET_EMAIL=

# --- Agent ----------------------------------------------------------------------------------

# Anthropic API key for the triage agent. Leave empty here and export it from your shell, a
# keychain, or `op run` instead, so the key never sits in the repo folder. Set a monthly spend
# limit on the key.
ANTHROPIC_API_KEY=
# Default model for triage runs: a Haiku-class model keeps per-run cost low.
TRIAGE_MODEL=claude-haiku-5-5
# Model offered as a per-incident "re-run with a stronger model" option: Sonnet-class.
TRIAGE_MODEL_ESCALATION=claude-sonnet-5-5

# --- Dashboard login -----------------------------------------------------------------------

# Set by `scripts/create-secrets.sh` on EKS; generated by Compose locally.
# argon2id hashes of the admin and viewer passwords, from `make hash-password` (it prints each
# $ doubled, which this file needs because make reads it). Never put a plaintext password here.
# An empty hash means that account can't log in.
ADMIN_PASSWORD_HASH=
VIEWER_PASSWORD_HASH=
# Set by `scripts/create-secrets.sh` on EKS; generated by Compose locally.
# Signs the session cookie; at least 32 bytes (`openssl rand -hex 32`). The backend refuses to
# start without it. Changing it logs everyone out.
SESSION_SECRET=

# --- Intake ---------------------------------------------------------------------------------

# Comma-separated IAM paths aws-mcp may read and the intake treats as watched.
WATCHED_IAM_PATHS=/demo-app/
# live, or replay: recorded CloudTrail fixtures instead of AWS (`make demo-replay` sets this).
# The intake health indicator shows Replay, and Revert and Codify are disabled.
INTAKE_MODE=live
# Optional. The "Intake health" Grafana dashboard URL the intake panel links to, if the browser
# can reach it (e.g. http://localhost:3000/d/consoletrack-intake through a port-forward).
GRAFANA_URL=

# --- Local (Docker Compose, make local, make demo-replay) ----------------------------------

# Postgres for the backend. The default matches the Compose Postgres service; these local
# credentials aren't used anywhere else. EKS gets its URL from CloudNativePG instead.
DATABASE_URL=postgresql+psycopg://consoletrack:consoletrack@localhost:5432/consoletrack
# Host ports for the backend API and the Vite dev server (`npm run dev`).
BACKEND_PORT=8000
FRONTEND_PORT=5173
# Host port for the dashboard container under Compose (`make local`). Not 5173: that's Vite's
# dev port and Playwright's test server port, and outside CI Playwright reuses whatever already
# listens there, so `make test-e2e` would test this build instead of the mock app.
DASHBOARD_PORT=8080
# Host ports for Compose's Postgres (keep in step with DATABASE_URL) and ElasticMQ, the local
# SQS-compatible queue. Compose binds every port to 127.0.0.1 only.
POSTGRES_PORT=5432
ELASTICMQ_PORT=9324
