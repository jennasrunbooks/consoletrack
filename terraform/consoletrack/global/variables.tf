# Every input comes from .env through the Makefile as TF_VAR_<lowercase name> (`make tf-env`).

variable "aws_region" {
  description = "Region for the provider. Keep us-east-1: IAM's CloudTrail events reach EventBridge only there."
  type        = string
}

variable "name_suffix" {
  description = "Random suffix on every resource name (ct-<component>-<suffix>) and the value of the owner tag. Generated by `make bootstrap`."
  type        = string

  validation {
    condition     = can(regex("^[a-z0-9]{4,8}$", var.name_suffix))
    error_message = "name_suffix must be 4 to 8 lowercase letters or digits (NAME_SUFFIX in .env; `make bootstrap` generates one)."
  }
}

variable "enable_github_oidc" {
  description = "Create the GitHub OIDC provider and the ct-gh-{plan,apply,revert,deploy} roles."
  type        = bool
  default     = false
}

variable "github_repo" {
  description = "owner/repo the GitHub OIDC roles trust (your fork). Required when enable_github_oidc is true."
  type        = string
  default     = ""

  validation {
    condition     = var.github_repo == "" || can(regex("^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$", var.github_repo))
    error_message = "github_repo must be owner/repo, with no wildcards."
  }

  validation {
    condition     = !var.enable_github_oidc || var.github_repo != ""
    error_message = "github_repo (GITHUB_REPO) is required when enable_github_oidc is true."
  }
}

variable "operator_arn" {
  description = "IAM role or user ARN allowed to assume the demo developer role. Empty = the identity running Terraform (an assumed-role session is resolved to its role). Set it before CI applies this root, or the trust would switch to the CI role."
  type        = string
  default     = ""

  validation {
    condition     = var.operator_arn == "" || can(regex("^arn:[a-z-]+:iam::[0-9]+:(role|user)/", var.operator_arn))
    error_message = "operator_arn must be an IAM role or user ARN (not an sts assumed-role session ARN)."
  }
}

variable "domain" {
  description = "Hostname for HTTPS, e.g. consoletrack.example.com. Empty = no Route 53 zone."
  type        = string
  default     = ""

  validation {
    condition     = var.domain == "" || can(regex("^([a-z0-9-]+\\.)+[a-z]{2,}$", var.domain))
    error_message = "domain must be a lowercase hostname with at least one dot, e.g. consoletrack.example.com."
  }
}

variable "dns_parent" {
  description = "How the domain's zone is delegated: external (print NS records to add by hand) or route53 (parent zone in this account; Terraform adds them)."
  type        = string
  default     = "external"

  validation {
    condition     = contains(["external", "route53"], var.dns_parent)
    error_message = "dns_parent must be external or route53."
  }
}

variable "enable_budget" {
  description = "Create the monthly AWS Budgets alert. Turn off when billing lives in an Organizations management account."
  type        = bool
  default     = true
}

variable "budget_limit_usd" {
  description = "Monthly budget threshold in USD."
  type        = number
  default     = 25

  validation {
    condition     = var.budget_limit_usd > 0
    error_message = "budget_limit_usd must be positive."
  }
}

variable "budget_email" {
  description = "Where budget alerts go. Required when enable_budget is true."
  type        = string
  default     = ""

  validation {
    condition     = !var.enable_budget || can(regex("^[^@\\s]+@[^@\\s]+$", var.budget_email))
    error_message = "budget_email (BUDGET_EMAIL) must be an email address when enable_budget is true."
  }
}
