# Every input comes from .env through the Makefile as TF_VAR_<lowercase name> (`make tf-env`).

variable "aws_region" {
  description = "Region for the provider. This root is the us-east-1 platform: IAM's CloudTrail events reach EventBridge only there."
  type        = string

  validation {
    condition     = var.aws_region == "us-east-1"
    error_message = "terraform/consoletrack/us-east-1 deploys to us-east-1 only (AWS_REGION in .env)."
  }
}

variable "name_suffix" {
  description = "Random suffix on every resource name (ct-<component>-use1-<suffix>) and the value of the owner tag. Generated by `make bootstrap`."
  type        = string

  validation {
    condition     = can(regex("^[a-z0-9]{4,8}$", var.name_suffix))
    error_message = "name_suffix must be 4 to 8 lowercase letters or digits (NAME_SUFFIX in .env; `make bootstrap` generates one)."
  }
}

variable "vpc_cidr" {
  description = "IPv4 CIDR for the VPC. A /16 to /20; the subnets are carved from it."
  type        = string
  default     = "10.0.0.0/16"

  validation {
    condition     = can(cidrhost(var.vpc_cidr, 0)) && tonumber(split("/", var.vpc_cidr)[1]) >= 16 && tonumber(split("/", var.vpc_cidr)[1]) <= 20
    error_message = "vpc_cidr must be an IPv4 CIDR between /16 and /20."
  }
}

variable "k8s_version" {
  description = "EKS Kubernetes version: the latest in standard support (extended support costs 6x)."
  type        = string
  default     = "1.36"

  validation {
    condition     = can(regex("^1\\.[0-9]+$", var.k8s_version))
    error_message = "k8s_version must look like 1.36."
  }
}

variable "use_spot" {
  description = "Run the node group on Spot (about half the price); false for on-demand."
  type        = bool
  default     = true
}

variable "node_instance_type" {
  description = "Graviton (arm64) instance type for the node group; the images are arm64 only."
  type        = string
  default     = "t4g.medium"

  validation {
    condition     = can(regex("^[a-z0-9]+g[a-z0-9]*\\.[a-z0-9]+$", var.node_instance_type))
    error_message = "node_instance_type must be a Graviton type (t4g, m7g, c7g, ...): the node AMI and images are arm64."
  }
}

variable "eks_public_access_cidrs" {
  description = "Comma-separated CIDRs allowed to reach the EKS API's public endpoint. Default 0.0.0.0/0: GitHub-hosted runners deploy through it (product-spec.md → Identity and access)."
  type        = string
  default     = "0.0.0.0/0"

  validation {
    condition = alltrue([
      for c in split(",", var.eks_public_access_cidrs) : can(cidrhost(trimspace(c), 0))
    ])
    error_message = "eks_public_access_cidrs must be a comma-separated list of IPv4 CIDRs."
  }
}

variable "exposure" {
  description = "port-forward (nothing public) or alb (creates the Load Balancer Controller's Pod Identity role)."
  type        = string
  default     = "port-forward"

  validation {
    condition     = contains(["port-forward", "alb"], var.exposure)
    error_message = "exposure must be port-forward or alb."
  }
}

variable "domain" {
  description = "Hostname for HTTPS, e.g. consoletrack.example.com. Non-empty = ACM certificate and the ExternalDNS role, in the zone the global root created."
  type        = string
  default     = ""

  validation {
    condition     = var.domain == "" || can(regex("^([a-z0-9-]+\\.)+[a-z]{2,}$", var.domain))
    error_message = "domain must be a lowercase hostname with at least one dot, e.g. consoletrack.example.com."
  }
}

variable "watched_iam_paths" {
  description = "Comma-separated IAM paths aws-mcp may read, e.g. /demo-app/. Never /ct/ or /."
  type        = string
  default     = "/demo-app/"

  validation {
    condition = alltrue([
      for p in split(",", var.watched_iam_paths) :
      can(regex("^/[A-Za-z0-9_+=,.@-]+(/[A-Za-z0-9_+=,.@-]+)*/$", trimspace(p))) && trimspace(p) != "/ct/"
    ])
    error_message = "watched_iam_paths must be IAM paths like /demo-app/ (leading and trailing slash), not / or /ct/."
  }
}

variable "enable_github_oidc" {
  description = "The global root created the ct-gh-* roles: add the deploy role's EKS access entry."
  type        = bool
  default     = false
}

variable "operator_arn" {
  description = "IAM role or user ARN that gets cluster admin. Empty = the identity running Terraform (an assumed-role session is resolved to its role). Set it before CI applies this root, or admin would move to the CI role."
  type        = string
  default     = ""

  validation {
    condition     = var.operator_arn == "" || can(regex("^arn:[a-z-]+:iam::[0-9]+:(role|user)/", var.operator_arn))
    error_message = "operator_arn must be an IAM role or user ARN (not an sts assumed-role session ARN)."
  }
}
