# bucket and region come from -backend-config, generated by `make tf-init` from .env
# (ct-tfstate-<NAME_SUFFIX> in AWS_REGION). The bucket is created by scripts/bootstrap-state.sh.
# Locking uses S3's native .tflock object next to the state; there is no DynamoDB table.
terraform {
  backend "s3" {
    key          = "consoletrack/us-east-1/terraform.tfstate"
    use_lockfile = true
    encrypt      = true
  }
}
